# Fixture-lər bayt-bayt determinist qalmalıdır — parser testləri onlara
# əsaslanır. Git-in avtomatik CRLF çevirməsi testləri platformadan asılı edər.
fixtures/**/*.jsonl -text eol=lf
fixtures/**/*.json  -text eol=lf

# Mənbə kodu hər platformada LF
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.css  text eol=lf
*.html text eol=lf

# Windows skriptləri CRLF olmalıdır
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
